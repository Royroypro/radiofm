# =====================================================================
# RadioClub25 — variables de entorno
# Copie este archivo a .env y cambie TODO lo marcado con CAMBIAR.
# Genere secretos con:  openssl rand -hex 24
# .env nunca se sube al repositorio (.gitignore).
# Nota: no ponga comentarios al final de una línea con valor.
# =====================================================================

# ---------- App ----------
# development | production
APP_ENV=production
# URL pública, sin "/" final
BASE_URL=https://radioclub25.sehuacho.com
APP_TIMEZONE=America/Lima
# Puerto local (solo 127.0.0.1) al que apunta nginx
APP_PORT=8120
# true detrás de HTTPS (obligatorio en producción)
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# Tamaño máximo de archivo subido en MB (el plan puede bajarlo)
MAX_UPLOAD_MB=100
# Secreto para anonimizar IPs en las estadísticas (16+ caracteres)
IP_HASH_SALT=CAMBIAR
# Secreto que comparten app, MediaMTX e Icecast para /internal/* (16+ caracteres)
INTERNAL_TOKEN=CAMBIAR

# Superadmin inicial: se crea al arrancar SOLO si no existe ninguno.
# Luego puede vaciar estas líneas. Alternativa:
#   docker compose exec app radioweb create-superadmin EMAIL CLAVE
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---------- Icecast (radio) ----------
ICECAST_MOUNT=/radio
# Contraseña que usa BUTT/Mixxx en la PC emisora (usuario "source")
ICECAST_SOURCE_PASSWORD=CAMBIAR
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=CAMBIAR
ICECAST_RELAY_PASSWORD=CAMBIAR

# ---------- MediaMTX (TV) ----------
MEDIAMTX_TV_PATH=tv

# ---------- Ingesta (se muestra en Admin → Streams y emisión) ----------
# Host al que se conecta la PC emisora
INGEST_HOST=radioclub25.sehuacho.com
ICECAST_PUBLIC_PORT=8010
RTMP_PUBLIC_PORT=1935
SRT_PUBLIC_PORT=8890

# ---------- Club25 Estudio (PC de la radio) ----------
# Coordenadas de la emisora: la PC las usa para la temperatura locutada (Open-Meteo).
STATION_LAT=-11.1067
STATION_LON=-77.6050
# Puerto local del HLS (solo 127.0.0.1, lo usa nginx)
HLS_LOCAL_PORT=8888
